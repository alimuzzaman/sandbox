# NOTE: all machine-state now lives under $SANDBOX_HOME (default ~/sandbox),
# NOT in this repo (spec 009). Nothing under runtime/ is tracked anymore.
# Per-machine + per-dev state — auto-generated by ./sb
.env
.env.local
.active-project
.active-project.*
.focus
.focus.*
.mcp.json
.mcp.json.bak
sandbox.local.yml

# Plugin repos cloned by `./sb add` live here by default.
# Each plugin has its own git history; never check them into the sandbox repo.
plugins/

# Venvs (CLI deps + MCP server deps)
.cli-venv/
mcp/wp-server/.venv/
__pycache__/
*.pyc

# Memory grown by agents.
# repros/ stays local — they're machine-specific reproduction state.
# plugin-behavior/ is tracked — cross-plugin findings are worth sharing.
memory/repros/

# OS
.DS_Store

# Tooling venvs — auto-managed by ./sb
.cli-venv/

# Tailwind standalone CLI + scratch for scripts/build-web-css.sh
.cache/

# Web UI TypeScript toolchain (src/web). The built bundle config/sandbox-web.js
# IS committed (vendored); only the dev deps + dist are ignored.
src/web/node_modules/
src/web/dist/

# npm/pnpm artifacts from the root package.json (the `sandbox` bin shim has no
# JS deps — these regenerate on any npm/pnpm invocation and aren't committed).
node_modules/
pnpm-lock.yaml
package-lock.json

# Release tarballs from scripts/make-release.sh (built artifacts — upload to the
# public host, don't commit).
dist/
deploy/install-site/public/

# deploy build artifacts (regenerated by make-release + the deploy step)
deploy/install-image/install.sh
deploy/install-image/sandbox-latest.tar.gz
/tmp

# Playwright MCP scratch (snapshots/console logs)
.playwright-mcp/
/.claude/tmp

# scratch artifacts
tmp/
