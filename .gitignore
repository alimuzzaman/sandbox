# Per-machine + per-dev state — auto-generated by ./sb
.env
.env.local
.active-project
.focus
.mcp.json
.mcp.json.bak
sandbox.local.yml

# Runtime — WP core + plugin symlinks + uploaded data
runtime/wp/*
!runtime/wp/.gitkeep
runtime/plugins/*
!runtime/plugins/.gitkeep
runtime/snapshots/

# Plugin repos cloned by `./sb add` live here by default.
# Each plugin has its own git history; never check them into the sandbox repo.
plugins/

# Venvs (CLI deps + MCP server deps)
.cli-venv/
mcp/wp-server/.venv/
__pycache__/
*.pyc

# Memory grown by agents.
# repros/ stays local — they're machine-specific reproduction state.
# plugin-behavior/ is tracked — cross-plugin findings are worth sharing.
memory/repros/

# OS
.DS_Store
