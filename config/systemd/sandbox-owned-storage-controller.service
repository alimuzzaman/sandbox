[Unit]
Description=Sandbox Owned Storage Policy Controller
Documentation=https://github.com/alimuzzaman/sandbox
Requires=sandbox-owned-storage-controller.socket
After=network.target sandbox-owned-storage-controller.socket sandbox-owned-storage.service

[Service]
Type=simple
User=sandbox-owned-storage
Group=sandbox-owned-storage
ExecStart=/usr/bin/python3 /opt/sandbox/tools/owned-storage-controller.py
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=30s

# Sandboxing and security boundaries
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
StateDirectory=sandbox-owned-storage
RuntimeDirectory=sandbox-owned-storage
WorkingDirectory=/var/lib/sandbox-owned-storage

[Install]
WantedBy=multi-user.target
