[Unit]
Description=Sandbox Owned Storage Controller Socket
Documentation=https://github.com/alimuzzaman/sandbox

[Socket]
ListenStream=/run/sandbox-owned-storage/controller.sock
SocketUser=sandbox-owned-storage
SocketGroup=sandbox-owned-storage
SocketMode=0660
DirectoryMode=0755
Service=sandbox-owned-storage-controller.service

[Install]
WantedBy=sockets.target
