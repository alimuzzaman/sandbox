def cmd_focus(cfg, args) -> None:
    if args.clear:
        if FOCUS.exists():
            FOCUS.unlink()
        ok("Cleared plugin focus")
        return
    if not args.slug:
        if FOCUS.exists():
            print(FOCUS.read_text().strip())
        else:
            info("No focused plugin set")
        return
    FOCUS.write_text(args.slug)
    ok(f"Focused plugin: {args.slug}")
    print(f"  Tell your LLM:  \"I'm working on {args.slug}.\"")


