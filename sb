def cmd_setup(cfg, args) -> None:
    """One command: boot the stack, install WP, build MCP, wire Claude.

    Runs preflight (Docker + Python) but does NOT prompt for personal secrets.
    Users who need FluentBoards/GitHub creds run `./sb onboard`
    separately — keeps `setup` non-interactive for everyone else.
    """
    problems = _docker_preflight()
    sys.stdout.flush()
    if problems:
        print()
        print(f"  ✗ {problems} prerequisite(s) above must be fixed before the")
        print("    sandbox can run. Follow the → hint next to each failure,")
        print("    then re-run:  ./sb setup")
        print()
        sys.exit(1)

    print("\n▸ Booting docker stack (wp + db + mailpit)…")
    cmd_up(cfg, args)

    # Wait for WP to be reachable before `wp core install` to avoid races.
    rt = cfg.get("runtime", {})
    port = rt.get("wordpress_port", 8088)
    import urllib.request, time
    for _ in range(30):
        try:
            urllib.request.urlopen(f"http://localhost:{port}", timeout=2)
            break
        except Exception:
            time.sleep(1)

    print("\n▸ Installing WordPress + provisioning app password…")
    cmd_install(cfg, args)

    print("\n▸ Building wp-mcp Python venv…")
    cmd_mcp_install(cfg, args)

    print("\n▸ Wiring Claude Code…")
    # Reload cfg so the freshly-written app password is picked up.
    cfg = load_config()
    path, created = write_claude_mcp_config(cfg)
    ok(f"{'Wrote' if created else 'Updated'} {path}")

    print("\n▸ Verifying…")
    try:
        cmd_doctor(cfg, args)
    except SystemExit:
        pass  # doctor exits 1 on problems; we want to keep going to print next steps

    print()
    ok("Setup complete.")
    print()
    print("  Next:")
    projs = list((cfg.get("projects", {}) or {}).keys())
    if projs:
        print(f"    ./sb use <name>     # one of: {', '.join(projs)}")
        print(f"    ./sb add <repo>     # clone + activate your plugin")
        print(f"    ./sb focus <slug>   # tell Claude which plugin you're on")
    print(f"    cd {ROOT} && claude   # run Claude Code here — .mcp.json auto-loads")
    print()
    print("  Optional — connect external integrations on demand:")
    print("    ./sb connect fb     # FluentBoards (standup/report skills)")
    print("    ./sb connect gh     # GitHub (auto-detects gh CLI auth)")
    print()


def cmd_snapshot(cfg, args) -> None:
    """Save the current DB + uploads under runtime/snapshots/<name>/.

    DB is exported via `wp db export`; uploads are tar'd to keep symlinks intact.
    Restore with `./sb restore <name>`.
    """
    name = args.name
    if not re.match(r"^[\w.-]+$", name or ""):
        die("snapshot name must be [A-Za-z0-9._-]+")
    SNAPSHOTS_DIR.mkdir(parents=True, exist_ok=True)
    target = SNAPSHOTS_DIR / name
    if target.exists() and not args.force:
        die(f"snapshot '{name}' exists — pass --force to overwrite")
    target.mkdir(parents=True, exist_ok=True)

    # DB → snapshot.sql inside the container's view of the snapshot dir.
    # `wp db export` writes from within the wpcli container, so we mount the
    # snapshots dir as /snapshots for the duration of the call.
    info(f"Exporting DB → {target}/db.sql")
    compose("run", "--rm",
            "-v", f"{SNAPSHOTS_DIR}:/snapshots",
            "wpcli", "db", "export", f"/snapshots/{name}/db.sql",
            "--add-drop-table")

    # Uploads — preserve relative symlinks, skip if dir missing
    uploads = WP_DIR / "wp-content" / "uploads"
    if uploads.exists():
        info(f"Archiving uploads → {target}/uploads.tgz")
        run(["tar", "-C", str(uploads.parent), "-czf",
             str(target / "uploads.tgz"), "uploads"])
    active = _active_project_name() or ""
    (target / "META").write_text(f"project={active}\n")
    ok(f"Snapshot '{name}' saved.")


def cmd_restore(cfg, args) -> None:
    name = args.name
    target = SNAPSHOTS_DIR / name
    if not target.exists():
        die(f"no snapshot '{name}' under {SNAPSHOTS_DIR}")
    sql = target / "db.sql"
    if not sql.exists():
        die(f"snapshot is missing db.sql: {sql}")
    info(f"Importing DB ← {sql}")
    compose("run", "--rm",
            "-v", f"{SNAPSHOTS_DIR}:/snapshots",
            "wpcli", "db", "import", f"/snapshots/{name}/db.sql")
    tgz = target / "uploads.tgz"
    if tgz.exists():
        info(f"Restoring uploads ← {tgz}")
        run(["tar", "-C", str(WP_DIR / "wp-content"), "-xzf", str(tgz)])
    ok(f"Restored snapshot '{name}'.")


def cmd_snapshots(cfg, args) -> None:
    if not SNAPSHOTS_DIR.exists() or not any(SNAPSHOTS_DIR.iterdir()):
        info("No snapshots yet. Save one: ./sb snapshot <name>")
        return
    print()
    for entry in sorted(SNAPSHOTS_DIR.iterdir()):
        if not entry.is_dir():
            continue
        meta = ""
        m = entry / "META"
        if m.exists():
            meta = m.read_text().strip().replace("\n", " ")
        size = sum(f.stat().st_size for f in entry.rglob("*") if f.is_file())
        print(f"  {entry.name:<24} {size // 1024:>6} KB   {meta}")
    print()


