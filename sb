def cmd_introspect(cfg, args) -> None:
    """Dump live block/widget/shortcode registries to runtime/cache/*.json.

    Runs PHP via wp-cli's eval-file inside the wpcli container so the WP
    install is fully bootstrapped (all plugins active, all registries populated).
    """
    target = args.target or "all"
    valid = ["blocks", "widgets", "shortcodes", "all"]
    if target not in valid:
        die(f"unknown target '{target}' — choose from: {', '.join(valid)}")

    cache_dir = ROOT / "runtime" / "cache"
    cache_dir.mkdir(parents=True, exist_ok=True)

    targets = ["blocks", "widgets", "shortcodes"] if target == "all" else [target]

    inst = args.resolved_instance
    for t in targets:
        info(f"introspecting {t}…")
        php = INTROSPECT_PHP[t]
        # Pipe PHP source into wp eval-file - (stdin). We need to bypass our
        # `run` helper's stdout printing because we want to capture clean JSON.
        proc = subprocess.run(
            ["docker", "compose",
             "-p", project_name(inst),
             "-f", str(compose_file(inst)),
             "run", "--rm", "-T",
             "wpcli", "eval-file", "-"],
            input=php, text=True, capture_output=True, cwd=str(ROOT),
        )
        if proc.returncode != 0:
            print(proc.stderr, file=sys.stderr)
            die(f"introspect {t} failed (exit {proc.returncode})")

        # The wpcli container prints docker-compose log lines on stderr; stdout
        # is the JSON payload. But the wordpress:cli image sometimes emits
        # WP_DEBUG warnings inline. Strip anything before the opening { or [.
        raw = proc.stdout
        start = min((i for i in [raw.find('{'), raw.find('[')] if i >= 0), default=-1)
        if start < 0:
            die(f"introspect {t}: no JSON in output\n{raw[:500]}")
        json_text = raw[start:].strip()

        try:
            parsed = json.loads(json_text)
        except json.JSONDecodeError as e:
            die(f"introspect {t}: bad JSON ({e})\n{json_text[:500]}")

        out_path = cache_dir / f"{t}.json"
        out_path.write_text(json.dumps(parsed, indent=2))
        count = parsed.get("count", "?")
        ok(f"{t}: {count} entries → {out_path.relative_to(ROOT)}")


def cmd_clean(cfg, args) -> None:
    inst = args.resolved_instance
    if not args.yes:
        ans = input(f"This deletes the DB volume for instance '{inst}'. "
                    f"Continue? [y/N] ").lower()
        if ans != "y":
            return
    compose("down", "-v", instance=inst)
    ok(f"Stopped and wiped DB volume for instance '{inst}'")


def _next_free_port(start: int, used: set[int]) -> int:
    """Find the next port >= start that is not in `used` and not bound by
    another local listener. Avoids handing out a port the OS will reject."""
    import socket
    p = start
    while True:
        if p not in used:
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
                try:
                    s.bind(("127.0.0.1", p))
                    return p
                except OSError:
                    pass
        p += 1


def _pick_instance_ports(cfg: dict) -> dict[str, int]:
    """Pick wordpress_port, db_port, mailpit_port for a new instance.

    Walks every defined instance's resolved config to collect ports
    already claimed, then bumps each base by 1 until we find a free trio.
    Bases are picked off `main`'s defaults so new instances stay in the
    same numeric neighborhood (8188 → 8189 → 8190 …).
    """
    instances = resolve_instances(cfg)
    main = instances.get(DEFAULT_INSTANCE, {})
    used: set[int] = set()
    for inst in instances.values():
        used.update({inst["wordpress_port"], inst["db_port"], inst["mailpit_port"]})
    return {
        "wordpress_port": _next_free_port(main.get("wordpress_port", 8188) + 1, used),
        "db_port": _next_free_port(main.get("db_port", 3318) + 1, used),
        "mailpit_port": _next_free_port(main.get("mailpit_port", 8125) + 1, used),
    }


def cmd_instance(cfg, args) -> None:
    """Create / delete a sandbox instance end-to-end.

    `./sb instance create <name>` picks free ports, writes the block to
    sandbox.local.yml, boots the stack, installs WordPress, and prints
    the admin URL. Idempotent: re-running on an existing instance just
    re-applies (compose regen + ensures it's up).

    `./sb instance delete <name>` stops the stack, removes the volume,
    deletes runtime/wp-<name>/, removes the block from sandbox.local.yml,
    and removes the per-instance state files. Refuses to delete `main`
    (use ./sb clean for that).
    """
    action = args.action
    name = args.name

    if action not in ("create", "delete"):
        die("usage: ./sb instance create|delete <name>")
    if not re.match(r"^[a-z0-9][a-z0-9_-]{0,30}$", name or ""):
        die("instance name must be lowercase, start with [a-z0-9], "
            "and contain only [a-z0-9_-] (max 31 chars)")

    server = _valid_server(getattr(args, "server", None) or "apache")
    # Domain auto-defaults to <name>.sb unless --domain given or --no-domain set.
    # The instance name is already a valid hostname label (validated above).
    domain = getattr(args, "domain", None)
    if getattr(args, "no_domain", False):
        domain = None
    elif not domain and action == "create":
        domain = f"{name}.sb"
    if domain:
        domain = _valid_domain(domain)

    if action == "create":
        existing = resolve_instances(cfg)
        if name in existing and name != DEFAULT_INSTANCE:
            info(f"instance '{name}' already defined — re-applying "
                 f"(regenerating compose, ensuring stack is up)")
            args.resolved_instance = name
            cmd_up(cfg, args)
            return

        ports = _pick_instance_ports(cfg)
        info(f"picked ports: WP={ports['wordpress_port']} "
             f"DB={ports['db_port']} mailpit={ports['mailpit_port']}")
        info(f"web server: {server}")

        # Custom domain → map it to 127.0.0.1 in /etc/hosts (before install so
        # WP's siteurl is set to the domain). First time, auto-run the one-time
        # setup (password prompt once) so the user never has to run a separate
        # command. In a non-interactive context (web/CI) we can't prompt for
        # sudo → fall back to localhost with a clear message.
        if domain:
            if not domains_ready():
                if sys.stdin.isatty():
                    info(f"'{domain}' needs a one-time domain setup. Doing it now…")
                    _domains_setup(cfg)
                else:
                    info("custom domains need a one-time setup that requires a "
                         "password — run `./sb domains setup` in your terminal.")
            okh, msg = _hosts_edit("add", domain) if domains_ready() else (False, "not set up")
            if okh:
                ok(f"mapped {domain} → 127.0.0.1")
            else:
                info(f"continuing on localhost for now ({msg}).")
                domain = None

        block = {
            "wordpress_port": ports["wordpress_port"],
            "db_port": ports["db_port"],
            "mailpit_port": ports["mailpit_port"],
            "server": server,
            "admin": {"site_title": f"Sandbox {name}"},
        }
        if domain:
            block["domain"] = domain
        local = _local_yaml()
        local.setdefault("instances", {})[name] = block
        _write_local_yaml(local)
        ok(f"Wrote instances.{name} to {CONFIG_LOCAL.name}")

        # Reload cfg now that the new block is on disk, then regenerate
        # compose files (the legacy main() flow already ran with the
        # *previous* cfg before we knew this instance existed).
        cfg = load_config()
        write_compose_files(cfg)

        # Boot + install in one shot. Cmd_up + cmd_install both read
        # args.resolved_instance, so set it.
        args.resolved_instance = name
        print(f"\n▸ Booting docker stack for '{name}'…")
        cmd_up(cfg, args)

        # Wait for WP to be reachable before wp core install.
        import urllib.request, time
        port = ports["wordpress_port"]
        for _ in range(30):
            try:
                urllib.request.urlopen(f"http://localhost:{port}", timeout=2)
                break
            except Exception:
                time.sleep(1)

        print(f"\n▸ Installing WordPress on '{name}'…")
        cmd_install(cfg, args)

        # Register this instance's own MCP server so Claude can reach it.
        # Reload cfg first — cmd_install just wrote the app password into
        # sandbox.local.yml, and registration bakes it into the server's env.
        cfg = load_config()
        print(f"\n▸ Registering MCP server for '{name}'…")
        register_claude_user_scope(cfg)

        # Add this instance's route to the clean-URL proxy (if running).
        if domain:
            proxy_reload(cfg)

        srv = mcp_server_name(name)
        base = site_url(resolve_instances(cfg)[name]) if domain \
            else f"http://localhost:{port}"
        print()
        ok(f"Instance '{name}' ready at {base}/wp-admin/")
        if domain:
            print(f"  Domain: {domain} (mapped to 127.0.0.1)")
        print(f"  Server: {server}")
        print(f"  Admin: admin / admin")
        print(f"  MCP server: {srv}  (Claude tools: mcp__{srv}__*)")
        print()
        print(f"  Next:")
        print(f"    ./sb use <project> --instance {name}     # link + activate plugins")
        print(f"    ./sb wp --instance {name} plugin list")
        print(f"    ./sb instances                           # see all")
        return

    # delete
    if name == DEFAULT_INSTANCE:
        die(f"refusing to delete the '{DEFAULT_INSTANCE}' instance — "
            f"it's the implicit default. Use `./sb clean` to wipe its "
            f"data, or remove the runtime: block from sandbox.yml.")

    instances = resolve_instances(cfg)
    if name not in instances:
        die(f"unknown instance '{name}'. Defined: "
            f"{', '.join(instances.keys())}")

    if not args.yes:
        print(f"\n  This will:")
        print(f"    • stop + remove all containers for instance '{name}'")
        print(f"    • delete the DB volume")
        print(f"    • delete runtime/wp-{name}/ and runtime/snapshots/{name}/")
        print(f"    • remove instances.{name} from sandbox.local.yml")
        print(f"    • delete .focus.{name} / .active-project.{name}")
        print()
        ans = input(f"  Type the instance name '{name}' to confirm: ").strip()
        if ans != name:
            info("cancelled")
            return

    # 1. Stop + remove containers + volume
    args.resolved_instance = name
    info(f"stopping + removing containers + volume for '{name}'")
    compose("down", "-v", instance=name, check=False)

    # 2. Remove WP install dir + snapshots
    for path in (wp_dir(name), snapshots_dir(name)):
        if path.exists():
            info(f"removing {path}")
            shutil.rmtree(path, ignore_errors=True)

    # 3. Remove state files
    for path in (focus_file(name), active_project_file(name)):
        if path.exists():
            info(f"removing {path}")
            path.unlink()

    # 4. Remove compose file
    cf = compose_file(name)
    if cf.exists():
        cf.unlink()

    # 5. Remove block from sandbox.local.yml (only — never touch sandbox.yml)
    local = _local_yaml()
    if name in (local.get("instances") or {}):
        del local["instances"][name]
        if not local["instances"]:
            del local["instances"]
        _write_local_yaml(local)
        info(f"removed instances.{name} from {CONFIG_LOCAL.name}")

    # 6. Deregister this instance's MCP server (never the bare `sandbox` =
    #    main — that's only removed by wiping main, not here).
    claude_bin = shutil.which("claude")
    if claude_bin:
        srv = mcp_server_name(name)
        subprocess.run([claude_bin, "mcp", "remove", "--scope", "user", srv],
                       capture_output=True, text=True)
        info(f"deregistered MCP server {srv}")

    # 7. Remove its custom-domain /etc/hosts mapping + proxy route, if any.
    dom = instances.get(name, {}).get("domain")
    if dom:
        okh, msg = _hosts_edit("remove", dom)
        info(f"removed domain {dom} from /etc/hosts" if okh
             else f"could not remove {dom} from /etc/hosts ({msg})")
        proxy_reload(load_config())

    ok(f"Instance '{name}' deleted.")


def _instance_running(name: str) -> bool:
    """True if the instance's `wp` web container reports running."""
    ps = compose("ps", "--format", "json", instance=name,
                 check=False, capture=True)
    for ln in (ps.stdout or "").splitlines():
        try:
            row = json.loads(ln)
        except ValueError:
            continue
        if row.get("Service") == "wp" and row.get("State") == "running":
            return True
    return False


def collect_instance_rows(cfg: dict) -> list[dict]:
    """Per-instance view-model shared by `cmd_instances` (static print) and the
    `dashboard` TUI, so the two never drift. One dict per instance with status,
    URLs, server, MCP server name, active project, and focus.
    """
    rows = []
    for name, inst_cfg in resolve_instances(cfg).items():
        apf = active_project_file(name)
        ff = focus_file(name)
        rows.append({
            "name": name,
            "running": _instance_running(name),
            "wordpress_port": inst_cfg["wordpress_port"],
            "mailpit_port": inst_cfg["mailpit_port"],
            "url": site_url(inst_cfg),
            "domain": inst_cfg.get("domain"),
            "server": inst_cfg.get("server", "apache"),
            "mcp_server": mcp_server_name(name),
            "project": apf.read_text().strip() if apf.exists() else "—",
            "focus": ff.read_text().strip() if ff.exists() else "—",
        })
    return rows


def _free_port_80() -> None:
    """Stop a Homebrew nginx (or anything the user controls) holding :80 so the
    sandbox proxy can bind it. Best-effort; only touches Homebrew nginx."""
    res = subprocess.run(["lsof", "-nP", "-iTCP:80", "-sTCP:LISTEN"],
                         capture_output=True, text=True)
    if ":80 (LISTEN)" not in (res.stdout or ""):
        return
    if "nginx" in (res.stdout or "") and shutil.which("brew"):
        info("freeing :80 — stopping Homebrew nginx (revert: brew services start nginx)")
        subprocess.run(["brew", "services", "stop", "nginx"],
                       capture_output=True, text=True)
        import time; time.sleep(1)


def domains_ready() -> bool:
    """True when both prerequisites are in place: passwordless hosts edits AND
    the clean-URL proxy running."""
    return _hosts_passwordless() and _proxy_running()


def _domains_setup(cfg, quiet: bool = False) -> bool:
    """Do the one-time domain setup: install the passwordless hosts sudoers
    rule (sudo prompt, once), free :80, and start the proxy. Returns True on
    success. Requires an interactive terminal for the sudo prompt — callers
    should check sys.stdin.isatty() first. Idempotent."""
    # 1. Passwordless sudoers rule for the hosts helper.
    if not _hosts_passwordless():
        import getpass
        user = getpass.getuser()
        rule = (f"# Installed by the sandbox — lets it edit /etc/hosts for "
                f"custom domains without a password.\n"
                f"{user} ALL=(root) NOPASSWD: {HOSTS_HELPER}\n")
        info("One-time domain setup — enter your password ONCE (never again).")
        tmp = ROOT / "runtime" / "sandbox-hosts.sudoers"
        tmp.write_text(rule)
        chk = subprocess.run(["sudo", "visudo", "-cf", str(tmp)],
                             capture_output=True, text=True)
        if chk.returncode != 0:
            tmp.unlink(missing_ok=True)
            info(f"sudoers rule failed validation: {chk.stderr.strip()}")
            return False
        inst = subprocess.run(
            ["sudo", "install", "-m", "0440", "-o", "root", "-g",
             "wheel" if sys.platform == "darwin" else "root",
             str(tmp), str(SUDOERS_FILE)], capture_output=True, text=True)
        tmp.unlink(missing_ok=True)
        if inst.returncode != 0:
            info(f"failed to install sudoers rule: {inst.stderr.strip()}")
            return False
        ok("hosts edits are now password-free.")

    # 2. Start the clean-URL proxy on :80.
    _free_port_80()
    write_proxy_config(cfg)
    write_proxy_compose()
    if not quiet:
        info("starting domain proxy on :80")
    up = subprocess.run(
        ["docker", "compose", "-f", str(PROXY_COMPOSE),
         "--project-directory", str(ROOT), "up", "-d"],
        capture_output=True, text=True)
    if up.returncode != 0:
        info(f"proxy failed to start (is :80 free?): {up.stderr.strip()}")
        return False
    # 3. Add hosts entries for any existing domains.
    for name, ic in resolve_instances(cfg).items():
        if ic.get("domain"):
            _hosts_edit("add", ic["domain"])
    return True


def cmd_domains(cfg, args) -> None:
    """Manage custom local domains + the clean-URL proxy.

    `./sb domains setup` — one-time: passwordless hosts rule + proxy on :80.
    `./sb domains list`  — show domain mappings + proxy status.
    `./sb domains down`  — stop the proxy.
    """
    action = getattr(args, "action", None) or "list"

    if action == "setup":
        if domains_ready():
            ok("Already set up — custom domains serve clean URLs.")
            return
        if _domains_setup(cfg):
            ok("Done. Custom domains now serve clean URLs, e.g. http://myapp.sb")
        else:
            die("domain setup did not complete (see messages above).")
        return

    if action == "down":
        subprocess.run(["docker", "compose", "-f", str(PROXY_COMPOSE),
                        "--project-directory", str(ROOT), "down"],
                       capture_output=True, text=True)
        ok("Domain proxy stopped. (Restart your nginx if needed: "
           "brew services start nginx)")
        return

    if action == "list":
        print()
        any_dom = False
        for name, ic in resolve_instances(cfg).items():
            if ic.get("domain"):
                any_dom = True
                print(f"  {name:<14} {site_url(ic)}")
        if not any_dom:
            info("No custom domains. Create one: "
                 "./sb instance create <name> --domain <name>.sb")
        print()
        hosts = "✓ set up" if _hosts_passwordless() else "✗ not set up"
        proxy = "✓ running" if _proxy_running() else "✗ not running"
        print(f"  hosts edits: {hosts}   proxy (:80): {proxy}")
        if not (_hosts_passwordless() and _proxy_running()):
            print(f"  → run ./sb domains setup for clean no-port URLs")
        print()
        return

    die("usage: ./sb domains setup|list|down")


def cmd_instances(cfg, args) -> None:
