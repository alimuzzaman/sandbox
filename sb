def cmd_install(cfg, args) -> None:
    rt = cfg.get("runtime", {})
    adm = rt.get("admin", {})
    port = rt.get("wordpress_port", 8088)
    wpcli([
        "core", "install",
        f"--url=http://localhost:{port}",
        f"--title={adm.get('site_title', 'Sandbox')}",
        f"--admin_user={adm.get('user', 'admin')}",
        f"--admin_password={adm.get('password', 'admin')}",
        f"--admin_email={adm.get('email', 'admin@example.com')}",
        "--skip-email",
    ])
    wpcli(["rewrite", "structure", "/%postname%/"])

    # Auto-provision an Application Password for the MCP server so wp_rest
    # works out of the box. Idempotent: deletes any prior 'wp-mcp' password
    # and re-creates so the value lands in sandbox.local.yml.
    info("Provisioning Application Password for wp-mcp…")
    wpcli([
        "user", "application-password", "delete",
        adm.get("user", "admin"), "wp-mcp", "--all",
    ], check=False, capture=True)
    res = wpcli([
        "user", "application-password", "create",
        adm.get("user", "admin"), "wp-mcp", "--porcelain",
    ], check=False, capture=True)
    app_pw = (res.stdout or "").strip().splitlines()[-1] if res.returncode == 0 else ""
    if app_pw:
        save_local_app_password(app_pw)
        ok("Application Password saved to sandbox.local.yml")
    else:
        info("(Could not auto-create Application Password — set it manually "
             "in sandbox.local.yml under mcp.wp.application_password)")

    ok(f"Admin URL: http://localhost:{port}/wp-admin "
       f"(user: {adm.get('user', 'admin')})")


def save_local_app_password(app_pw: str) -> None:
    """Persist the WP Application Password into sandbox.local.yml so the
    MCP server picks it up on next launch."""
    ensure_pyyaml()
    import yaml
    local = {}
    if CONFIG_LOCAL.exists():
        with CONFIG_LOCAL.open() as f:
            local = yaml.safe_load(f) or {}
    local.setdefault("mcp", {}).setdefault("wp", {})["application_password"] = app_pw
    with CONFIG_LOCAL.open("w") as f:
        yaml.safe_dump(local, f, default_flow_style=False, sort_keys=False)


def cmd_projects(cfg, args) -> None:
    projs = cfg.get("projects", {}) or {}
    if not projs:
        info("No projects defined in sandbox.yml")
        return
    print()
    for name, p in projs.items():
        desc = p.get("description", "").strip()
        print(f"  {name:<22} {desc}")
    print()


def cmd_use(cfg, args) -> None:
    name = args.name
    projs = cfg.get("projects", {}) or {}
    if name not in projs:
        die(f"unknown project '{name}'. Run: ./sb projects")
    proj = projs[name]

    # Step 1: symlink local plugin sources
    PLUGINS_DIR.mkdir(parents=True, exist_ok=True)
    for plug in proj.get("plugins", []) or []:
        slug = plug["slug"]
        src = Path(plug["source"])
        link = PLUGINS_DIR / slug
        if not src.exists():
            info(f"skip {slug}: source not found at {src}")
            continue
        if link.is_symlink() or link.exists():
            link.unlink()
        link.symlink_to(src)
        ok(f"linked {slug} → {src}")

    # Step 2: install wp.org dependencies
    for slug in proj.get("install_from_wporg", []) or []:
        info(f"installing {slug} from wp.org (if missing)…")
        wpcli(["plugin", "install", slug, "--activate"], check=False)

    # Step 3: activate plugins in order
    for plug in proj.get("plugins", []) or []:
        slug = plug["slug"]
        if not (PLUGINS_DIR / slug).exists():
            continue
        wpcli(["plugin", "activate", slug], check=False)

    ACTIVE.write_text(name)
    print()
    ok(f"Active project: {name}")
    print(f"  Tell your LLM:  \"I'm working on the '{name}' project.\"")


def parse_repo(spec: str, default_org: str | None) -> tuple[str, str]:
    """Return (clone_url, slug) for an input like 'org/repo', a full URL,
    or a bare 'repo' (which uses default_org)."""
    spec = spec.strip()
    if spec.startswith("git@") or spec.startswith("http"):
        url = spec
        slug = re.sub(r"\.git$", "", url.rstrip("/").split("/")[-1])
        return url, slug
    if "/" in spec:
        org, repo = spec.split("/", 1)
    else:
        if not default_org:
            die(f"no org for '{spec}'. Pass org/repo, or set "
                "defaults.github_org in sandbox.yml")
        org, repo = default_org, spec
    repo = re.sub(r"\.git$", "", repo)
    return f"https://github.com/{org}/{repo}.git", repo


def cmd_add(cfg, args) -> None:
    """Clone a plugin repo and wire it into the active project locally."""
    defaults = cfg.get("defaults", {}) or {}
    raw = defaults.get("plugins_home", "") or "./plugins"
    plugins_home = Path(raw).expanduser()
    if not plugins_home.is_absolute():
        plugins_home = (ROOT / plugins_home).resolve()
    plugins_home.mkdir(parents=True, exist_ok=True)

    url, slug = parse_repo(args.repo, defaults.get("github_org"))
    dest = plugins_home / slug

    if dest.exists():
        info(f"{slug} already at {dest} — reusing")
    else:
        info(f"Cloning {url} → {dest}")
        run(["git", "clone", url, str(dest)])
        ok(f"Cloned {slug}")

    # Symlink + activate in the live runtime
    PLUGINS_DIR.mkdir(parents=True, exist_ok=True)
    link = PLUGINS_DIR / slug
    if link.is_symlink() or link.exists():
        link.unlink()
    link.symlink_to(dest)
    ok(f"Linked {slug} → {dest}")

    wpcli(["plugin", "activate", slug], check=False)

    # Persist into sandbox.local.yml so `./sb use <active>` re-applies it
    persist_local_plugin(args.project or _active_project_name(), slug, str(dest))


def _active_project_name() -> str | None:
    return ACTIVE.read_text().strip() if ACTIVE.exists() else None


def persist_local_plugin(project: str | None, slug: str, source: str) -> None:
    if not project:
        info("(no active project — added to runtime only; "
             "run `./sb use <name>` first to make it sticky)")
        return
    ensure_pyyaml()
    import yaml
    local = {}
    if CONFIG_LOCAL.exists():
        with CONFIG_LOCAL.open() as f:
            local = yaml.safe_load(f) or {}
    proj = local.setdefault("projects", {}).setdefault(project, {})
    plugins = proj.setdefault("plugins", [])
    if not any(p.get("slug") == slug for p in plugins):
        plugins.append({"slug": slug, "source": source})
        with CONFIG_LOCAL.open("w") as f:
            yaml.safe_dump(local, f, default_flow_style=False, sort_keys=False)
        ok(f"Persisted '{slug}' under projects.{project} in sandbox.local.yml")


def cmd_doctor(cfg, args) -> None:
    """Audit the whole stack and report what's broken."""
    rt = cfg.get("runtime", {})
    adm = rt.get("admin", {})
    port = rt.get("wordpress_port", 8088)
    problems = 0

    def check(label: str, ok_: bool, hint: str = "") -> None:
        nonlocal problems
        mark = "✓" if ok_ else "✗"
        line = f"  {mark} {label}"
        if not ok_:
            problems += 1
            if hint:
                line += f"\n      → {hint}"
        print(line)

    print("\nContainers:")
    ps = compose("ps", "--format", "json", check=False, capture=True)
    containers = []
    for ln in (ps.stdout or "").splitlines():
        try:
            containers.append(json.loads(ln))
        except ValueError:
            pass
    services = {c.get("Service"): c.get("State") for c in containers}
    for svc in ("wp", "db", "mailpit"):
        check(f"{svc} running", services.get(svc) == "running",
              hint=f"./sb up   (currently: {services.get(svc, 'missing')})")

    print("\nWordPress:")
    r = wpcli(["core", "is-installed"], check=False, capture=True)
    check("core installed", r.returncode == 0,
          hint="./sb install")

    print("\nMCP wiring:")
    mcp_cfg = (cfg.get("mcp", {}) or {}).get("wp", {}) or {}
    app_pw = mcp_cfg.get("application_password", "")
    check("application_password set", bool(app_pw),
          hint="./sb install   (auto-provisions and writes to sandbox.local.yml)")
    if app_pw:
        try:
            import base64, urllib.request, urllib.error
            req = urllib.request.Request(
                f"http://localhost:{port}/wp-json/wp/v2/users/me")
            token = base64.b64encode(
                f"{adm.get('user', 'admin')}:{app_pw}".encode()).decode()
            req.add_header("Authorization", f"Basic {token}")
            try:
                with urllib.request.urlopen(req, timeout=5) as r:
                    status = r.status
            except urllib.error.HTTPError as e:
                status = e.code
            check(f"REST auth works (status {status})", 200 <= status < 300,
                  hint="rerun ./sb install to refresh the password")
        except Exception as e:
            check("REST auth works", False, hint=str(e))
    check("wp-mcp venv built", (MCP_VENV / "bin" / "python").exists(),
          hint="./sb mcp-install")

    print("\nState:")
    active = _active_project_name()
    check(f"active project: {active or '—'}", bool(active),
          hint="./sb use <name>")
    focus = FOCUS.read_text().strip() if FOCUS.exists() else None
    check(f"focused plugin: {focus or '—'}", True,
          hint="(optional — set with ./sb focus <slug>)")

    print("\nLinked plugins:")
    expected = []
    if active:
        proj = (cfg.get("projects", {}) or {}).get(active, {}) or {}
        expected = [p.get("slug") for p in (proj.get("plugins") or [])]
    if not PLUGINS_DIR.exists() and expected:
        check("wp-content/plugins/ exists", False, hint="./sb use <name>")
    elif PLUGINS_DIR.exists():
        linked = []
        for entry in sorted(PLUGINS_DIR.iterdir()):
            if entry.is_symlink():
                linked.append(entry.name)
                tgt = entry.resolve()
                check(f"{entry.name} → {tgt}", tgt.exists(),
                      hint=f"source missing — ./sb add {entry.name}")
        for slug in expected:
            if slug not in linked:
                check(f"{slug} linked", False,
                      hint=f"./sb add {slug}   (project expects it)")
        if not linked and not expected:
            info("  (no source-symlinked plugins — project uses install_from_wporg only)")

    print()
    if problems:
        info(f"{problems} issue(s) — see → hints above")
        sys.exit(1)
    ok("All checks passed.")


