PROJECT_MCP_JSON = ROOT / ".mcp.json"   # Claude Code auto-loads this when run from ROOT


def _build_mcp_entry(cfg: dict, instance: str = DEFAULT_INSTANCE) -> dict:
    """Build the Claude MCP registration entry for one instance's server.

    Every per-instance server runs the SAME server.py but with the
    instance-correct ports/creds baked into its env, plus SANDBOX_INSTANCE
    so the server defaults all its tools to that instance. That env binding
    is what keeps concurrent sessions on different instances isolated.
    """
    inst_cfg = resolve_instances(cfg)[instance]
    adm = inst_cfg["admin"]
    port = inst_cfg["wordpress_port"]
    mailpit_port = inst_cfg["mailpit_port"]
    # App password: per-instance under instances.<name>.app_password; for
    # main, fall back to the legacy mcp.wp.application_password key. (Read
    # from the raw block — resolve_instances() doesn't carry app_password.)
    raw_inst = (cfg.get("instances") or {}).get(instance, {}) or {}
    app_pw = raw_inst.get("app_password") or ""
    if instance == DEFAULT_INSTANCE and not app_pw:
        app_pw = (cfg.get("mcp", {}) or {}).get("wp", {}).get(
            "application_password", "")
    return {
        "command": str(MCP_VENV / "bin" / "python"),
        "args": [str(MCP_DIR / "server.py")],
        "env": {
            # Binds this server (and all its tools' defaults) to one instance.
            "SANDBOX_INSTANCE": instance,
            "WP_URL": f"http://localhost:{port}",
            "WP_ADMIN_USER": adm.get("user", "admin"),
            # Browser-login password — `visit` uses this to authenticate
            # against wp-login.php so the agent can load wp-admin URLs
            # autonomously. Separate from WP_APP_PASSWORD (REST-only).
            "WP_ADMIN_PASSWORD": adm.get("password", "admin"),
            "WP_APP_PASSWORD": app_pw,
            "MAILPIT_URL": f"http://localhost:{mailpit_port}",
            # Path to the sandbox root so the MCP server can invoke
            # tools/visit/visit.py via the tools venv.
            "SANDBOX_ROOT": str(ROOT),
        },
    }


def _register_one_mcp_server(claude_bin: str, cfg: dict, instance: str) -> bool:
    """(Re)register a single instance's MCP server at user scope. Idempotent
    wipe-then-add so re-running setup picks up rotated creds / ports."""
    name = mcp_server_name(instance)
    entry = _build_mcp_entry(cfg, instance)
    subprocess.run([claude_bin, "mcp", "remove", "--scope", "user", name],
                   capture_output=True, text=True)
    env_args = []
    for k, v in (entry.get("env") or {}).items():
        env_args += ["-e", f"{k}={v}"]
    # NB: server name MUST precede -e flags — commander.js treats -e as
    # variadic and otherwise consumes the name as an env-var value.
    cmd = [
        claude_bin, "mcp", "add", "--scope", "user",
        name, *env_args, "--",
        entry["command"], *entry.get("args", []),
    ]
    res = subprocess.run(cmd, capture_output=True, text=True)
    if res.returncode != 0:
        info(f"  {name}: registration failed: {res.stderr.strip()}")
        return False
    return True


def register_claude_user_scope(cfg: dict) -> None:
    """Register ONE MCP server per sandbox instance at user scope, so every
    `claude` session on the machine can reach every instance regardless of cwd.

    Each instance's server bakes SANDBOX_INSTANCE (+ that instance's
    WP_URL/creds) into its env, so a session that calls `mcp__sandbox-<name>__*`
    defaults all its tools to that instance and never collides with another
    session's focus/active-project state. `main` keeps the bare `sandbox` name.

    Idempotent: each server is wiped and re-added so re-running setup updates
    env vars (e.g. after a password rotation). The legacy `wp-sandbox` name
    (pre-rename) is also removed once.
    """
    claude_bin = shutil.which("claude")
    if not claude_bin:
        info("claude CLI not in PATH — skipping user-scope MCP registration.")
        return

    # One-time cleanup of the pre-rename name.
    subprocess.run([claude_bin, "mcp", "remove", "--scope", "user", "wp-sandbox"],
                   capture_output=True, text=True)

    registered = []
    for instance in resolve_instances(cfg):
        if _register_one_mcp_server(claude_bin, cfg, instance):
            registered.append((instance, mcp_server_name(instance)))

    if registered:
        ok("Registered per-instance MCP servers at user scope:")
        for instance, name in registered:
            print(f"    {name:24s} → instance '{instance}'  "
                  f"(tools: mcp__{name}__*)")
    else:
        info("No MCP servers registered.")
        info("Project-local .mcp.json still works when cwd is the sandbox.")


def write_claude_mcp_config(cfg: dict) -> tuple[Path, bool]:
    """Write the project-local .mcp.json inside the sandbox folder.

    Claude Code (and other MCP clients) auto-load .mcp.json from the working
    directory. The user-scope registration (see register_claude_user_scope)
    is what makes the servers available outside the sandbox folder.

    Writes one server entry per instance (`sandbox` for main,
    `sandbox-<name>` for others) — mirrors register_claude_user_scope so
    cwd-local sessions get the same per-instance isolation.
    """
    existing = {}
    created = not PROJECT_MCP_JSON.exists()
    if not created:
        try:
            existing = json.loads(PROJECT_MCP_JSON.read_text()) or {}
        except json.JSONDecodeError:
            backup = PROJECT_MCP_JSON.with_suffix(".json.bak")
            PROJECT_MCP_JSON.rename(backup)
            info(f"existing .mcp.json was invalid JSON — backed up to {backup}")
            existing = {}
            created = True
    servers = existing.setdefault("mcpServers", {})
    # Drop stale per-instance entries we own so deleted instances don't linger.
    current = {mcp_server_name(i) for i in resolve_instances(cfg)}
    for name in list(servers):
        if (name == "sandbox" or name.startswith("sandbox-")) \
                and name not in current:
            del servers[name]
    for instance in resolve_instances(cfg):
        servers[mcp_server_name(instance)] = _build_mcp_entry(cfg, instance)
    PROJECT_MCP_JSON.write_text(json.dumps(existing, indent=2) + "\n")
    return PROJECT_MCP_JSON, created


SECRETS_ENV = ROOT / ".env.local"


def _local_yaml() -> dict:
    ensure_pyyaml()
    import yaml
    if CONFIG_LOCAL.exists():
        with CONFIG_LOCAL.open() as f:
            return yaml.safe_load(f) or {}
    return {}


def _write_local_yaml(local: dict) -> None:
    ensure_pyyaml()
    import yaml
    with CONFIG_LOCAL.open("w") as f:
        yaml.safe_dump(local, f, default_flow_style=False, sort_keys=False)


def _write_env_local(values: dict) -> None:
    """Write/merge KEY=VAL pairs into .env.local. Existing keys are replaced;
    others preserved. Empty values are skipped."""
    existing: dict[str, str] = {}
    if SECRETS_ENV.exists():
        for ln in SECRETS_ENV.read_text().splitlines():
            if "=" in ln and not ln.lstrip().startswith("#"):
                k, v = ln.split("=", 1)
                existing[k.strip()] = v
    for k, v in values.items():
        if v:
            existing[k] = v
    lines = ["# Personal secrets for the sandbox — gitignored, never commit.",
             "# Source from your shell or let skills read directly.", ""]
    for k, v in existing.items():
        lines.append(f"{k}={v}")
    SECRETS_ENV.write_text("\n".join(lines) + "\n")
    try:
        SECRETS_ENV.chmod(0o600)
    except OSError:
        pass


def _docker_preflight() -> int:
    """Check prerequisites are usable. Returns problem count."""
    problems = 0
    print("\nPrerequisites:")

    # Python — script wouldn't have started without it, but warn on too-old
    # versions and on missing `venv` module (Debian/Ubuntu split it out, which
    # silently breaks .cli-venv and mcp/wp-server/.venv).
    py_ver = sys.version_info
    if (py_ver.major, py_ver.minor) < (3, 9):
        problems += 1
        print(f"  ✗ Python {py_ver.major}.{py_ver.minor} is too old (need 3.9+)")
        print("      → macOS: `brew install python@3.12`")
        print("      → Ubuntu/Debian: `sudo apt install python3.12 python3.12-venv`")
        print("      → Or use pyenv: https://github.com/pyenv/pyenv")
    else:
        print(f"  ✓ python {py_ver.major}.{py_ver.minor}.{py_ver.micro}")

    r = subprocess.run([sys.executable, "-m", "venv", "--help"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        problems += 1
        print("  ✗ python3 `venv` module not available")
        print("      → Ubuntu/Debian: `sudo apt install python3-venv`")
        print("      → (needed to build .cli-venv and mcp/wp-server/.venv)")
    else:
        print("  ✓ python3 -m venv works")

    docker_bin = shutil.which("docker")
    if not docker_bin:
        problems += 1
        print("  ✗ docker not found in PATH")
        print("      → install Docker Desktop: https://docs.docker.com/get-docker/")
        return problems
    print(f"  ✓ docker found ({docker_bin})")

    r = subprocess.run(["docker", "info"], capture_output=True, text=True)
    if r.returncode != 0:
        problems += 1
        print("  ✗ docker is installed but not running")
        print("      → macOS:  open -a Docker      (then wait ~10s for it to start)")
        print("      → Linux:  sudo systemctl start docker")
        print("      → check:  docker info         (should print without errors)")
        return problems
    print("  ✓ docker daemon running")

    r = subprocess.run(["docker", "compose", "version"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        problems += 1
        print("  ✗ `docker compose` plugin not available")
        print("      → install Compose v2: https://docs.docker.com/compose/install/")
    else:
        print(f"  ✓ {r.stdout.strip()}")
    return problems


def _prompt(label: str, default: str = "", secret: bool = False) -> str:
    """Prompt the user. Empty input keeps the default (or skips if no default)."""
    if default:
        hint = "•••••• (saved)" if secret else default
        suffix = f" [{hint}] (Enter to keep)"
    else:
        suffix = " (Enter to skip)"
    if secret:
        import getpass
        val = getpass.getpass(f"  {label}{suffix}: ").strip()
    else:
        val = input(f"  {label}{suffix}: ").strip()
    return val or default


