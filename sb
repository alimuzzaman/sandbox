#!/bin/sh
# Sandbox CLI — entry point for everyone (designers, devs, QA).
# All configuration lives in sandbox.yml. Run `./sb` for help.
#
# Polyglot bootstrap: the shell catches a missing python3 with a friendly
# install hint, then re-execs this same file under python3. Python's parser
# treats the next triple-quoted block as the module docstring and skips it.
""":"
if ! command -v python3 >/dev/null 2>&1; then
    cat <<'EOF' >&2
error: python3 is required to run ./sb but was not found.

Install it, then re-run ./sb setup:
  • macOS:          brew install python
  • Ubuntu/Debian:  sudo apt install python3 python3-venv
  • Fedora/RHEL:    sudo dnf install python3 python3-virtualenv
  • Windows (WSL):  install Ubuntu via WSL, then the Ubuntu line above
  • Or use pyenv:   https://github.com/pyenv/pyenv
EOF
    exit 1
fi
exec python3 "$0" "$@"
":"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
CONFIG = ROOT / "sandbox.yml"
CONFIG_LOCAL = ROOT / "sandbox.local.yml"
COMPOSE = ROOT / "docker-compose.yml"
COMPOSE_DIR = ROOT / "runtime" / "compose"

# Multi-instance constants. The "main" instance preserves the
# pre-multi-instance behavior; additional instances live in
# sandbox.yml under `instances:` and get their own compose project,
# DB volume, WP dir, ports, and state files.
DEFAULT_INSTANCE = "main"

# Legacy state files (pre-multi-instance) — these are the *main* instance's
# state on disk after the one-time migration in `cmd_apply`. New code reads
# them via `active_project_file()` / `focus_file()`; these aliases stay so
# any older code paths still find them.
ACTIVE = ROOT / ".active-project"
FOCUS = ROOT / ".focus"

# Pre-multi-instance WP dir. After `cmd_apply`, `runtime/wp/` is migrated to
# `runtime/wp-main/` and a compat symlink at the old path keeps these aliases
# valid for one release. New code uses `wp_dir(instance)`.
WP_DIR = ROOT / "runtime" / "wp"
PLUGINS_DIR = WP_DIR / "wp-content" / "plugins"
SNAPSHOTS_DIR = ROOT / "runtime" / "snapshots"
SEEDS_DIR = ROOT / "runtime" / "seeds"
MCP_DIR = ROOT / "mcp" / "wp-server"
MCP_VENV = MCP_DIR / ".venv"
CLI_VENV = ROOT / ".cli-venv"
TOOLS_DIR = ROOT / "tools"
TOOLS_VENV = ROOT / "runtime" / ".venv-tools"


# ----------------------------- utilities -----------------------------

def die(msg: str, code: int = 1) -> None:
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(code)


def info(msg: str) -> None:
    print(f"• {msg}")


def ok(msg: str) -> None:
    print(f"✓ {msg}")


def run(cmd: list[str], check: bool = True, capture: bool = False, **kw):
    if not capture:
        print(f"  $ {' '.join(cmd)}")
    res = subprocess.run(cmd, check=False, text=True,
                         capture_output=capture, cwd=str(ROOT), **kw)
    if check and res.returncode != 0:
        sys.exit(res.returncode)
    return res


def ensure_pyyaml() -> None:
    """Ensure PyYAML is importable.

    PEP 668 ("externally-managed-environment") prevents pip --user installs
    against system/homebrew Pythons, so we keep the CLI's deps in its own
    venv at .cli-venv/ and re-exec ourselves through it on first run.
    """
    try:
        import yaml  # noqa: F401
        return
    except ImportError:
        pass

    cli_py = CLI_VENV / "bin" / "python"
    if not cli_py.exists():
        info("Creating CLI venv at .cli-venv/ (one-time)…")
        subprocess.check_call([sys.executable, "-m", "venv", str(CLI_VENV)])
        subprocess.check_call(
            [str(CLI_VENV / "bin" / "pip"), "install", "--quiet",
             "--disable-pip-version-check", "pyyaml"]
        )

    # If we're not already running under the CLI venv, re-exec there.
    # Compare sys.prefix (not sys.executable, which resolves to the underlying
    # interpreter binary that the venv symlinks to).
    if Path(sys.prefix).resolve() != CLI_VENV.resolve():
        os.execv(str(cli_py), [str(cli_py), str(Path(__file__).resolve()), *sys.argv[1:]])


def expand(value, vars_: dict) -> object:
    """Recursively expand ${var} references using vars_."""
    if isinstance(value, str):
        return re.sub(r"\$\{(\w+)\}", lambda m: str(vars_.get(m.group(1), m.group(0))), value)
    if isinstance(value, list):
        return [expand(v, vars_) for v in value]
    if isinstance(value, dict):
        return {k: expand(v, vars_) for k, v in value.items()}
    return value


def load_config() -> dict:
    ensure_pyyaml()
    import yaml
    if not CONFIG.exists():
        die(f"missing {CONFIG} — run from the sandbox/ directory")
    with CONFIG.open() as f:
        cfg = yaml.safe_load(f) or {}
    if CONFIG_LOCAL.exists():
        with CONFIG_LOCAL.open() as f:
            local = yaml.safe_load(f) or {}
        cfg = deep_merge(cfg, local)
    vars_ = cfg.get("defaults", {}) or {}
    return expand(cfg, vars_)


def deep_merge(a: dict, b: dict) -> dict:
    out = dict(a)
    for k, v in b.items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = deep_merge(out[k], v)
        else:
            out[k] = v
    return out


# --------------------- multi-instance plumbing -----------------------
#
# Resolution model: `instances:` is an optional top-level block in
# sandbox.yml. Each instance inherits unset fields (ports, admin,
# images) from the top-level `runtime:` block. If `instances:` is
# absent entirely, we synthesize {"main": {}} so existing single-
# instance configs keep working with zero edits.

def resolve_instances(cfg: dict) -> dict[str, dict]:
    """Return {instance_name: resolved_instance_config}.

    Each resolved dict has: wordpress_port, db_port, mailpit_port,
    admin (dict), wordpress_image, mariadb_image, wpcli_image,
    project (str|None). Values come from per-instance overrides
    first, then the top-level runtime: block, then hardcoded defaults.
    """
    runtime = cfg.get("runtime", {}) or {}
    instances = cfg.get("instances")

    def merged(inst: dict) -> dict:
        # Per-instance values override runtime defaults; admin dict is
        # shallow-merged so a per-instance override (e.g. site_title)
        # doesn't require restating user/password/email.
        rt_admin = (runtime.get("admin") or {})
        inst_admin = (inst.get("admin") or {})
        return {
            "wordpress_port": inst.get("wordpress_port",
                                       runtime.get("wordpress_port", 8088)),
            "db_port": inst.get("db_port",
                                runtime.get("db_port", 3307)),
            "mailpit_port": inst.get("mailpit_port",
                                     runtime.get("mailpit_port", 8025)),
            "wordpress_image": inst.get("wordpress_image",
                                        runtime.get("wordpress_image",
                                                    "wordpress:latest")),
            "mariadb_image": inst.get("mariadb_image",
                                      runtime.get("mariadb_image",
                                                  "mariadb:latest")),
            "wpcli_image": inst.get("wpcli_image",
                                    runtime.get("wpcli_image",
                                                "wordpress:cli")),
            "admin": {**rt_admin, **inst_admin},
            "project": inst.get("project"),
        }

    if not instances:
        return {DEFAULT_INSTANCE: merged({})}
    out = {name: merged(inst or {}) for name, inst in instances.items()}
    # `main` is always implicitly available even when instances: lists
    # only additional instances — otherwise existing scripts that don't
    # pass --instance would suddenly fail when a `qa` block is added.
    out.setdefault(DEFAULT_INSTANCE, merged({}))
    return out


def compose_file(instance: str) -> Path:
    """Per-instance generated compose file path."""
    return COMPOSE_DIR / f"{instance}.yml"


def wp_dir(instance: str) -> Path:
    """Per-instance WordPress install dir."""
    return ROOT / "runtime" / f"wp-{instance}"


def plugins_dir(instance: str) -> Path:
    return wp_dir(instance) / "wp-content" / "plugins"


def active_project_file(instance: str) -> Path:
    return ROOT / f".active-project.{instance}"


def focus_file(instance: str) -> Path:
    return ROOT / f".focus.{instance}"


def snapshots_dir(instance: str) -> Path:
    return ROOT / "runtime" / "snapshots" / instance


def project_name(instance: str) -> str:
    """docker-compose project name — must be unique per instance."""
    return f"sandbox-{instance}"


def _plugins_home(cfg: dict) -> Path:
    """Resolve `defaults.plugins_home` to an absolute path, creating it."""
    defaults = cfg.get("defaults", {}) or {}
    raw = defaults.get("plugins_home", "") or "./plugins"
    p = Path(raw).expanduser()
    if not p.is_absolute():
        p = (ROOT / p).resolve()
    p.mkdir(parents=True, exist_ok=True)
    return p


def render_compose(instance: str, inst_cfg: dict, plugins_host: Path) -> str:
    """Build the docker-compose YAML for one instance.

    Mirrors the original docker-compose.yml structure but parameterizes
    project name, ports, volume name, and WP bind-mount target. Kept as
    a Python f-string (no Jinja2 dependency) — the template is small
    and stable enough to inline.
    """
    return f"""# Generated by ./sb — do not edit by hand. Edit sandbox.yml + re-run ./sb apply.
name: {project_name(instance)}

services:
  wp:
    image: {inst_cfg["wordpress_image"]}
    depends_on:
      db:
        condition: service_healthy
    ports:
      - "{inst_cfg["wordpress_port"]}:80"
    # The official wordpress:latest image ships Apache with
    # `AllowOverride None` for /var/www/, which silently breaks pretty
    # permalinks (wp-json/ 404s). Patch the conf on every start, then
    # hand off to the image's entrypoint.
    command: >
      bash -c "sed -i 's|AllowOverride None|AllowOverride All|g' /etc/apache2/apache2.conf
      && docker-entrypoint.sh apache2-foreground"
    environment:
      WORDPRESS_DB_HOST: db:3306
      WORDPRESS_DB_USER: wp
      WORDPRESS_DB_PASSWORD: wp
      WORDPRESS_DB_NAME: wp
      WORDPRESS_DEBUG: "1"
      WORDPRESS_CONFIG_EXTRA: |
        define('WP_DEBUG_LOG', true);
        define('WP_DEBUG_DISPLAY', false);
        define('SCRIPT_DEBUG', true);
        define('WP_ENVIRONMENT_TYPE', 'local');
    volumes:
      - ./runtime/wp-{instance}:/var/www/html
      - ./runtime/seeds:/seeds
      # Bind-mount plugin sources at the same absolute host path so the
      # symlinks `./sb add` creates under wp-content/plugins/ resolve
      # inside the container.
      - {plugins_host}:{plugins_host}
      - ./config/php-sandbox.ini:/usr/local/etc/php/conf.d/zz-sandbox.ini:ro

  db:
    image: {inst_cfg["mariadb_image"]}
    environment:
      MARIADB_DATABASE: wp
      MARIADB_USER: wp
      MARIADB_PASSWORD: wp
      MARIADB_ROOT_PASSWORD: root
    ports:
      - "{inst_cfg["db_port"]}:3306"
    volumes:
      - db_data:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "mariadb-admin --user=root --password=$$MARIADB_ROOT_PASSWORD ping --silent"]
      interval: 5s
      retries: 20

  mailpit:
    image: axllent/mailpit
    ports:
      - "{inst_cfg["mailpit_port"]}:8025"
      - "1025"

  wpcli:
    image: {inst_cfg["wpcli_image"]}
    depends_on:
      - wp
    user: "33:33"
    working_dir: /var/www/html
    environment:
      WORDPRESS_DB_HOST: db:3306
      WORDPRESS_DB_USER: wp
      WORDPRESS_DB_PASSWORD: wp
      WORDPRESS_DB_NAME: wp
    volumes:
      - ./runtime/wp-{instance}:/var/www/html
      - ./runtime/seeds:/seeds
      - {plugins_host}:{plugins_host}
      - ./config/php-sandbox.ini:/usr/local/etc/php/conf.d/zz-sandbox.ini:ro
    entrypoint: ["wp", "--allow-root"]
    command: ["--info"]

volumes:
  db_data:
"""


def write_compose_files(cfg: dict) -> None:
    """Regenerate one compose file per instance under runtime/compose/.

    Idempotent: safe to call on every `sb` invocation. Old compose files
    for instances no longer in sandbox.yml are removed so stale stacks
    don't linger.
    """
    COMPOSE_DIR.mkdir(parents=True, exist_ok=True)
    plugins_host = _plugins_home(cfg)
    instances = resolve_instances(cfg)

    # Write current instances
    current_files = set()
    for name, inst_cfg in instances.items():
        path = compose_file(name)
        path.write_text(render_compose(name, inst_cfg, plugins_host))
        current_files.add(path.name)

    # Remove orphaned compose files (instance was deleted from sandbox.yml).
    # Only remove .yml under our managed dir — don't touch user files.
    for existing in COMPOSE_DIR.glob("*.yml"):
        if existing.name not in current_files:
            existing.unlink()


def _legacy_stack_running() -> bool:
    """True if a docker-compose stack is up under the old (pre-multi-instance)
    project name `sandbox`, indicating an in-flight install we shouldn't
    blindly migrate underneath of."""
    try:
        res = subprocess.run(
            ["docker", "compose", "-p", "sandbox", "ps", "-q"],
            capture_output=True, text=True, cwd=str(ROOT), timeout=10,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return False
    return bool((res.stdout or "").strip())


def migrate_legacy_layout() -> None:
    """One-time migration of pre-multi-instance state into the `main` slot.

    Moves runtime/wp/ → runtime/wp-main/, runtime/snapshots/* into
    runtime/snapshots/main/, and .active-project / .focus into their
    per-instance equivalents. Leaves compat symlinks at the old paths so
    callers that still hardcode `runtime/wp/` etc. keep working for one
    release.

    Idempotent: no-op when the new layout is already in place. Refuses
    to migrate while a docker stack is running under the old project
    name `sandbox` — moving runtime/wp/ to runtime/wp-main/ would yank
    the bind-mount target out from under live containers.
    """
    # State files: .active-project → .active-project.main, etc.
    # Always safe to migrate (small files, no container reads them).
    legacy_state = [
        (ROOT / ".active-project", active_project_file(DEFAULT_INSTANCE)),
        (ROOT / ".focus",          focus_file(DEFAULT_INSTANCE)),
    ]
    for old, new in legacy_state:
        if old.exists() and not old.is_symlink() and not new.exists():
            old.rename(new)
        if new.exists() and not old.exists():
            old.symlink_to(new.name)

    # WP dir + snapshots — only migrate when no legacy stack is running.
    old_wp = ROOT / "runtime" / "wp"
    new_wp = wp_dir(DEFAULT_INSTANCE)
    needs_wp_migration = (old_wp.exists() and not old_wp.is_symlink()
                          and not new_wp.exists())

    if needs_wp_migration and _legacy_stack_running():
        info(
            "skipping runtime/wp/ → runtime/wp-main/ migration: a docker "
            "stack is running under the old project name `sandbox`. Stop "
            "it first: `docker compose -p sandbox down` (NOT `./sb down`, "
            "which targets sandbox-main)."
        )
        return

    if needs_wp_migration:
        info(f"migrating runtime/wp/ → runtime/wp-{DEFAULT_INSTANCE}/ (one-time)")
        old_wp.rename(new_wp)
    if new_wp.exists() and not old_wp.exists():
        # Compat symlink so old hardcoded refs (`./runtime/wp/...`) keep working.
        old_wp.symlink_to(new_wp.name)

    # runtime/snapshots/<name>/ → runtime/snapshots/main/<name>/
    snap_root = ROOT / "runtime" / "snapshots"
    main_snap = snapshots_dir(DEFAULT_INSTANCE)
    if snap_root.exists():
        for entry in list(snap_root.iterdir()):
            # Skip the per-instance dirs themselves.
            if entry.name == DEFAULT_INSTANCE or entry.is_symlink():
                continue
            if entry.is_dir():
                main_snap.mkdir(parents=True, exist_ok=True)
                target = main_snap / entry.name
                if not target.exists():
                    entry.rename(target)


def compose(*args: str, instance: str = DEFAULT_INSTANCE,
            check: bool = True, capture: bool = False):
    """Run `docker compose` against one instance's stack.

    Uses the per-instance project name (-p sandbox-<instance>) and
    generated compose file. Caller must have run write_compose_files()
    at least once (the CLI entrypoint does this on every invocation).
    """
    return run(
        ["docker", "compose",
         "-p", project_name(instance),
         "-f", str(compose_file(instance)),
         *args],
        check=check, capture=capture,
    )


def wpcli(args: list[str], instance: str = DEFAULT_INSTANCE,
          check: bool = True, capture: bool = False):
    return compose("run", "--rm", "wpcli", *args,
                   instance=instance, check=check, capture=capture)


def write_env_for_compose(cfg: dict) -> None:
    """Legacy: materialize values for the checked-in docker-compose.yml.

    Pre-multi-instance, this wrote a `.env` file consumed by
    `docker-compose.yml` (the checked-in file). The new flow ignores
    that file entirely — each instance has its own generated compose
    file with values baked in. We keep this function so anyone calling
    it from out-of-tree code (or older skills) still gets a valid
    `.env`, but the multi-instance code path doesn't depend on it.
    """
    rt = cfg.get("runtime", {})
    plugins_home = _plugins_home(cfg)
    env = ROOT / ".env"
    env.write_text(
        f"WP_PORT={rt.get('wordpress_port', 8088)}\n"
        f"DB_PORT={rt.get('db_port', 3307)}\n"
        f"MAILPIT_PORT={rt.get('mailpit_port', 8025)}\n"
        f"SANDBOX_PLUGINS_HOST={plugins_home}\n"
    )


# ----------------------------- commands ------------------------------

def cmd_up(cfg: dict, args) -> None:
    inst = args.resolved_instance
    inst_cfg = resolve_instances(cfg)[inst]
    compose("up", "-d", "wp", "db", "mailpit", instance=inst)
    ok(f"WordPress: http://localhost:{inst_cfg['wordpress_port']}")
    ok(f"Mailpit:   http://localhost:{inst_cfg['mailpit_port']}")


def cmd_down(cfg, args) -> None:
    compose("down", instance=args.resolved_instance)


def cmd_status(cfg, args) -> None:
    inst = args.resolved_instance
    compose("ps", instance=inst)
    apf = active_project_file(inst)
    ff = focus_file(inst)
    if apf.exists():
        ok(f"Active project: {apf.read_text().strip()}")
    else:
        info("No active project (run: ./sb use <name>)")
    if ff.exists():
        ok(f"Focused plugin: {ff.read_text().strip()}")
    else:
        info("No focused plugin (run: ./sb focus <slug>)")


def _project_for_plugin(cfg: dict, slug: str) -> str | None:
    """Return the best-fit project name that contains `slug`, or None.

    Prefer a project whose name matches the plugin slug (the common
    convention: `embedpress` project contains `embedpress`). Otherwise
    return the first project that lists the plugin.
    """
    projs = cfg.get("projects", {}) or {}
    candidates = []
    for name, p in projs.items():
        plugin_slugs = [(pl or {}).get("slug") for pl in (p.get("plugins") or [])]
        if slug in plugin_slugs:
            candidates.append(name)
    if not candidates:
        return None
    if slug in candidates:
        return slug
    return candidates[0]


def cmd_focus(cfg, args) -> None:
    inst = args.resolved_instance
    ff = focus_file(inst)
    apf = active_project_file(inst)
    if args.clear:
        if ff.exists():
            ff.unlink()
        ok("Cleared plugin focus")
        return
    if not args.slug:
        if ff.exists():
            print(ff.read_text().strip())
        else:
            info("No focused plugin set")
        return
    ff.write_text(args.slug)
    ok(f"Focused plugin: {args.slug}")

    # Auto-link: if the focused plugin isn't already in the active
    # project's plugin list, switch the active project to one that
    # contains it. Keeps focus + active_project consistent so users
    # don't have to think about both concepts.
    active = apf.read_text().strip() if apf.exists() else None
    projs = cfg.get("projects", {}) or {}
    active_slugs = []
    if active and active in projs:
        active_slugs = [(pl or {}).get("slug")
                        for pl in (projs[active].get("plugins") or [])]
    if args.slug in active_slugs:
        # Already aligned — nothing to do.
        print(f"  Active project: {active} (contains {args.slug})")
        return

    target = _project_for_plugin(cfg, args.slug)
    if not target:
        info(f"plugin '{args.slug}' isn't in any defined project — add "
             f"it to sandbox.yml or sandbox.local.yml to enable "
             f"auto-provisioning. Focus set; active project unchanged.")
        return

    if active == target:
        # Active project IS the right one but doesn't list this plugin
        # — config drift; bail rather than re-provision.
        info(f"active project '{active}' is the best match for "
             f"'{args.slug}' but doesn't list it. Check sandbox.yml.")
        return

    info(f"switching active project: {active or '(none)'} → {target} "
         f"(contains '{args.slug}')")
    import types
    cmd_use(cfg, types.SimpleNamespace(name=target, resolved_instance=inst))


def cmd_logs(cfg, args) -> None:
    compose("logs", "-f", "wp", "db", instance=args.resolved_instance)


def cmd_shell(cfg, args) -> None:
    compose("exec", "wp", "bash", instance=args.resolved_instance)


def cmd_install(cfg, args) -> None:
    inst = args.resolved_instance
    inst_cfg = resolve_instances(cfg)[inst]
    adm = inst_cfg["admin"]
    port = inst_cfg["wordpress_port"]
    wpcli([
        "core", "install",
        f"--url=http://localhost:{port}",
        f"--title={adm.get('site_title', 'Sandbox')}",
        f"--admin_user={adm.get('user', 'admin')}",
        f"--admin_password={adm.get('password', 'admin')}",
        f"--admin_email={adm.get('email', 'admin@example.com')}",
        "--skip-email",
    ], instance=inst)
    wpcli(["rewrite", "structure", "/%postname%/"], instance=inst)

    # Auto-provision an Application Password for the MCP server so wp_rest
    # works out of the box. Idempotent: deletes any prior 'wp-mcp' password
    # and re-creates so the value lands in sandbox.local.yml.
    info("Provisioning Application Password for wp-mcp…")
    wpcli([
        "user", "application-password", "delete",
        adm.get("user", "admin"), "wp-mcp", "--all",
    ], instance=inst, check=False, capture=True)
    res = wpcli([
        "user", "application-password", "create",
        adm.get("user", "admin"), "wp-mcp", "--porcelain",
    ], instance=inst, check=False, capture=True)
    app_pw = (res.stdout or "").strip().splitlines()[-1] if res.returncode == 0 else ""
    if app_pw:
        save_local_app_password(app_pw, instance=inst)
        ok("Application Password saved to sandbox.local.yml")
    else:
        info("(Could not auto-create Application Password — set it manually "
             "in sandbox.local.yml under mcp.wp.application_password)")

    ok(f"Admin URL: http://localhost:{port}/wp-admin "
       f"(user: {adm.get('user', 'admin')})")


def save_local_app_password(app_pw: str, instance: str = DEFAULT_INSTANCE) -> None:
    """Persist the WP Application Password into sandbox.local.yml so the
    MCP server picks it up on next launch.

    For the default `main` instance, writes to the legacy
    `mcp.wp.application_password` key for backwards compatibility.
    For other instances, writes to `instances.<name>.app_password` so
    each instance has its own secret without colliding.
    """
    ensure_pyyaml()
    import yaml
    local = {}
    if CONFIG_LOCAL.exists():
        with CONFIG_LOCAL.open() as f:
            local = yaml.safe_load(f) or {}
    if instance == DEFAULT_INSTANCE:
        local.setdefault("mcp", {}).setdefault("wp", {})["application_password"] = app_pw
    else:
        local.setdefault("instances", {}).setdefault(instance, {})["app_password"] = app_pw
    with CONFIG_LOCAL.open("w") as f:
        yaml.safe_dump(local, f, default_flow_style=False, sort_keys=False)


def cmd_projects(cfg, args) -> None:
    projs = cfg.get("projects", {}) or {}
    if not projs:
        info("No projects defined in sandbox.yml")
        return
    print()
    for name, p in projs.items():
        desc = p.get("description", "").strip()
        print(f"  {name:<22} {desc}")
    print()


SANDBOX_CLAUDE_BEGIN = "<!-- sandbox:auto-generated — regenerated by ./sb -->"
SANDBOX_CLAUDE_END = "<!-- /sandbox:auto-generated -->"


def _drop_sandbox_claude_md(plugin_src: Path, slug: str, cfg: dict) -> None:
    """Write a `CLAUDE.local.md` into the plugin's source repo so that Claude
    Code, when opened with the plugin as cwd, can discover the sandbox.

    Without this, every new Claude session is blind to the running stack —
    no idea which URL to visit, which container to wp-cli into, or that
    `./sb visit` even exists. The file is keyed on the WP plugin slug, lives
    at the plugin repo root, and is *idempotent*: each run regenerates the
    file inside sentinel markers so manual additions outside the block
    survive. We also exclude it from the plugin's git via .git/info/exclude
    so the WPDev / partner repo's own history stays clean.
    """
    if not plugin_src or not plugin_src.exists() or not plugin_src.is_dir():
        return

    rt = cfg.get("runtime", {}) or {}
    wp_port = rt.get("wordpress_port", 8088)
    admin = (rt.get("admin") or {})
    admin_user = admin.get("user", "admin")
    admin_pass = admin.get("password", "admin")
    active = ACTIVE.read_text().strip() if ACTIVE.exists() else "(none)"
    focus = FOCUS.read_text().strip() if FOCUS.exists() else "(none)"

    block = f"""{SANDBOX_CLAUDE_BEGIN}
# Sandbox context

This plugin (`{slug}`) is symlinked into a WPDeveloper Sandbox running on
this machine.

- Sandbox repo:     `{ROOT}`
- WordPress URL:    http://localhost:{wp_port}/  (admin: {admin_user}/{admin_pass})
- Mailpit:          http://localhost:{rt.get('mailpit_port', 8025)}/
- Active project:   `{active}`
- Focused plugin:   `{focus}`

## Common commands (run from `{ROOT}`)

```
./sb visit <url>                    headless-browser inspector — returns JSON
./sb visit <url> --check-iframes    also probes each iframe loaded
./sb visit <url> --screenshot PATH  save a PNG
./sb wp <wp-cli args>               run wp-cli inside the container
./sb status                         container + project + focus state
./sb focus <plugin>                 switch which plugin is "in focus"
./sb open admin | site | mail       open in browser
./sb logs                           tail WP + DB logs
```

## Conventions when working on this plugin

- For UI / rendering / iframe / editor work, prefer `./sb visit` over `curl`.
  curl is blind to runtime DOM, iframes, and JS console errors.
- Don't edit files inside `vendor/` — patch from plugin code or send an
  upstream PR. Vendor edits are wiped on `composer install`.
- The plugin's source lives here (`{plugin_src}`) and is bind-mounted into
  the WP container, so changes are live without restart.

{SANDBOX_CLAUDE_END}
"""

    target = plugin_src / "CLAUDE.local.md"
    existing = target.read_text() if target.exists() else ""

    if SANDBOX_CLAUDE_BEGIN in existing and SANDBOX_CLAUDE_END in existing:
        head, _, rest = existing.partition(SANDBOX_CLAUDE_BEGIN)
        _, _, tail = rest.partition(SANDBOX_CLAUDE_END)
        new = head + block + tail
    elif existing.strip():
        new = existing.rstrip() + "\n\n" + block
    else:
        new = block
    target.write_text(new)

    # Keep CLAUDE.local.md out of the plugin's git index without modifying
    # the tracked .gitignore (which may be owned by the plugin's repo). Use
    # .git/info/exclude — local to this clone, never committed.
    git_dir = plugin_src / ".git"
    if git_dir.is_dir():
        exclude = git_dir / "info" / "exclude"
        exclude.parent.mkdir(parents=True, exist_ok=True)
        line = "CLAUDE.local.md"
        body = exclude.read_text() if exclude.exists() else ""
        if line not in body.splitlines():
            with exclude.open("a") as f:
                if body and not body.endswith("\n"):
                    f.write("\n")
                f.write("# Added by ./sb — local-only, not for the plugin's tree\n"
                        f"{line}\n")


def _force_symlink(link: Path, src: Path) -> None:
    """Replace whatever is at `link` with a symlink to `src`.

    `link.unlink()` fails with EPERM on a real (non-symlink) directory, which
    is exactly the state we hit when a wp.org install of the same slug already
    sits in the plugins folder. Detect that case and remove the directory tree
    instead. Symlinks (even dangling ones) get unlinked normally.
    """
    if link.is_symlink():
        link.unlink()
    elif link.is_dir():
        # Plain `rmtree` follows nothing here — link is a real dir, not a link.
        shutil.rmtree(link)
    elif link.exists():
        link.unlink()
    link.symlink_to(src)


def _parse_pick_input(raw: str, name_to_idx: dict[str, int],
                      idx_to_name: dict[int, str]) -> list[str]:
    """Parse a picker selection string into an ordered list of project names.

    Accepts space- or comma-separated mix of numbers, ranges (1-3), 'all',
    and slug names. Unknown tokens are silently dropped — the caller shows
    the final confirm-list so typos are obvious.
    """
    raw = (raw or "").strip().lower()
    if not raw or raw == "none":
        return []
    if raw == "all":
        return [idx_to_name[i] for i in sorted(idx_to_name)]
    seen: set[str] = set()
    chosen: list[str] = []

    def take(name: str):
        if name and name not in seen:
            seen.add(name)
            chosen.append(name)

    for token in re.split(r"[\s,]+", raw):
        if not token:
            continue
        if "-" in token and all(p.isdigit() for p in token.split("-")):
            lo, hi = (int(x) for x in token.split("-"))
            for i in range(lo, hi + 1):
                if i in idx_to_name:
                    take(idx_to_name[i])
        elif token.isdigit():
            i = int(token)
            if i in idx_to_name:
                take(idx_to_name[i])
        elif token in name_to_idx:
            take(token)
    return chosen


def _resolve_plugin_github(plug: dict, project_org: str, default_org: str) -> str | None:
    """Pick the GitHub <org>/<repo> to clone for a plugin entry.

    Resolution order:
      1. explicit `github: "<org>/<repo>"` on the plugin
      2. explicit `github_repo: "<repo>"` on the plugin combined with the
         project- or defaults-level `github_org`
      3. fallback: <project_org or default_org>/<slug>

    Returns None when nothing usable can be assembled, so the caller can
    print a precise error instead of falling through to a 404.
    """
    explicit = (plug.get("github") or "").strip()
    if explicit and "/" in explicit:
        return explicit
    repo_name = (plug.get("github_repo") or plug.get("slug") or "").strip()
    org = (project_org or default_org or "").strip()
    if not (org and repo_name):
        return None
    return f"{org}/{repo_name}"


def _install_picked_project(cfg: dict, name: str, report: dict,
                            instance: str = DEFAULT_INSTANCE) -> None:
    """Materialize a project from sandbox.yml.

    Clone source plugins (when not already on disk), symlink them into the
    runtime, install any wp.org runtime deps, activate everything. Per-plugin
    failures are collected into `report` so the picker can summarize them at
    the end — one wrong slug shouldn't abort the whole batch.
    """
    projects = cfg.get("projects", {}) or {}
    proj = projects.get(name)
    if not proj:
        report["skipped"].append((name, "not in sandbox.yml"))
        return

    defaults = cfg.get("defaults", {}) or {}
    plugins_home = _plugins_home(cfg)
    default_org = (defaults.get("github_org") or "").strip()
    project_org = (proj.get("github_org") or "").strip()

    plug_dir = plugins_dir(instance)
    plug_dir.mkdir(parents=True, exist_ok=True)

    for plug in proj.get("plugins", []) or []:
        slug = plug["slug"]
        src = Path(plug.get("source") or (plugins_home / slug))
        src = src.expanduser()
        if not src.is_absolute():
            src = (ROOT / src).resolve()

        if not src.exists():
            target = _resolve_plugin_github(plug, project_org, default_org)
            if not target:
                report["failed"].append((slug,
                    "no github_org set and no explicit `github:` field — "
                    "run `./sb connect gh` or add `github: <org>/<repo>` "
                    "to the plugin entry in sandbox.yml"))
                continue
            url = f"https://github.com/{target}.git"
            info(f"cloning {url} → {src}")
            res = subprocess.run(["git", "clone", url, str(src)],
                                 capture_output=True, text=True)
            if res.returncode != 0:
                stderr = (res.stderr or "").strip().lower()
                if "repository not found" in stderr or "not found" in stderr:
                    hint = (
                        f"github.com/{target} is 404 — most likely wrong org "
                        f"name or wrong repo name. If the actual repo lives "
                        f"elsewhere set `github: <org>/<repo>` on the plugin "
                        f"in sandbox.yml. If it's private, ensure `gh auth` "
                        f"can read it."
                    )
                elif "authentication" in stderr or "denied" in stderr or "403" in stderr:
                    hint = (
                        f"clone of {target} was denied — likely private/Pro. "
                        f"Run `gh auth refresh -s repo,read:org` or skip."
                    )
                else:
                    hint = res.stderr.strip() or "git clone failed"
                report["failed"].append((slug, hint))
                continue

        link = plug_dir / slug
        _force_symlink(link, src)
        ok(f"linked {slug} → {src}")
        report["linked"].append(slug)
        _drop_sandbox_claude_md(src, slug, cfg)

    for slug in proj.get("install_from_wporg", []) or []:
        info(f"installing {slug} from wp.org (if missing)…")
        wpcli(["plugin", "install", slug, "--activate"],
              instance=instance, check=False)
        report["wporg"].append(slug)

    for plug in proj.get("plugins", []) or []:
        slug = plug["slug"]
        if (plug_dir / slug).exists():
            wpcli(["plugin", "activate", slug], instance=instance, check=False)


def cmd_pick(cfg, args) -> None:
    """Interactive multi-select for the project catalog defined in sandbox.yml.

    Replaces the manual `./sb use <x>` + `./sb add <r>` * N loop with one
    pass: read the catalog, show a numbered checklist split by source-dev
    vs designer-only, parse the selection, clone + symlink + activate.
    """
    projects = cfg.get("projects", {}) or {}
    if not projects:
        die("no projects defined in sandbox.yml")

    src_dev = {n: p for n, p in projects.items() if p.get("plugins")}
    designer = {n: p for n, p in projects.items() if not p.get("plugins")}

    name_to_idx: dict[str, int] = {}
    idx_to_name: dict[int, str] = {}

    print()
    print("  Pick projects to set up.")
    i = 1
    if src_dev:
        print()
        print("  Source dev (clones repos into plugins_home):")
        for n, p in src_dev.items():
            desc = (p.get("description") or "").strip()
            print(f"   {i:>2})  [ ]  {n:<22} {desc}")
            name_to_idx[n] = i
            idx_to_name[i] = n
            i += 1
    if designer:
        print()
        print("  Designer / QA (wp.org plugins only):")
        for n, p in designer.items():
            desc = (p.get("description") or "").strip()
            print(f"   {i:>2})  [ ]  {n:<22} {desc}")
            name_to_idx[n] = i
            idx_to_name[i] = n
            i += 1

    print()
    print("  Enter numbers (e.g. '1 3 5'), ranges ('1-3'), 'all', 'none',")
    print("  or slug names ('embedpress notificationx'):")
    try:
        raw = input("  > ")
    except (EOFError, KeyboardInterrupt):
        print()
        return

    chosen = _parse_pick_input(raw, name_to_idx, idx_to_name)
    if not chosen:
        info("nothing selected")
        return

    print()
    print(f"  Will set up: {', '.join(chosen)}")
    try:
        confirm = input("  Proceed? [Y/n]: ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return
    if confirm and confirm not in ("y", "yes"):
        info("cancelled")
        return

    inst = args.resolved_instance
    report = {"linked": [], "failed": [], "wporg": [], "skipped": []}
    print()
    for name in chosen:
        print(f"▸ {name}")
        _install_picked_project(cfg, name, report, instance=inst)
        print()

    # Summary — make failures impossible to miss after a long run.
    print()
    if report["linked"]:
        ok(f"Linked: {', '.join(report['linked'])}")
    if report["wporg"]:
        info(f"wp.org plugins installed: {', '.join(sorted(set(report['wporg'])))}")
    if report["failed"]:
        print()
        print("  ✗ Could not set up these plugins:")
        for slug, why in report["failed"]:
            print(f"      {slug}")
            for line in (why or "").splitlines() or [""]:
                print(f"        {line}")
        print()
        print("  Hints:")
        print("    • Wrong default org?       ./sb connect gh")
        print("    • Explicit repo per plug?  add `github: <org>/<repo>` in sandbox.yml")
        print("    • Already cloned locally?  add `source: <abs-path>` to point at it")

    # If exactly one was picked AND no prior active, activate it.
    apf = active_project_file(inst)
    cur_active = apf.read_text().strip() if apf.exists() else None
    if len(chosen) == 1 and not cur_active:
        apf.write_text(chosen[0])
        ok(f"Active project: {chosen[0]}")
    elif cur_active and cur_active in chosen:
        info(f"Active project unchanged: {cur_active}  (switch with `./sb use <name>`)")
    else:
        info(f"Set active with:  ./sb use <one of: {', '.join(chosen)}>")


def cmd_use(cfg, args) -> None:
    name = args.name
    inst = args.resolved_instance
    projs = cfg.get("projects", {}) or {}
    if name not in projs:
        die(f"unknown project '{name}'. Run: ./sb projects")
    proj = projs[name]

    plug_dir = plugins_dir(inst)
    # Step 1: symlink local plugin sources
    plug_dir.mkdir(parents=True, exist_ok=True)
    for plug in proj.get("plugins", []) or []:
        slug = plug["slug"]
        src = Path(plug["source"])
        link = plug_dir / slug
        if not src.exists():
            info(f"skip {slug}: source not found at {src}")
            continue
        _force_symlink(link, src)
        ok(f"linked {slug} → {src}")
        _drop_sandbox_claude_md(src, slug, cfg)

    # Step 2: install wp.org dependencies
    for slug in proj.get("install_from_wporg", []) or []:
        info(f"installing {slug} from wp.org (if missing)…")
        wpcli(["plugin", "install", slug, "--activate"],
              instance=inst, check=False)

    # Step 3: activate plugins in order
    for plug in proj.get("plugins", []) or []:
        slug = plug["slug"]
        if not (plug_dir / slug).exists():
            continue
        wpcli(["plugin", "activate", slug], instance=inst, check=False)

    active_project_file(inst).write_text(name)
    print()
    ok(f"Active project: {name}")
    print(f"  Tell your LLM:  \"I'm working on the '{name}' project.\"")


def parse_repo(spec: str, default_org: str | None) -> tuple[str, str]:
    """Return (clone_url, slug) for an input like 'org/repo', a full URL,
    or a bare 'repo' (which uses default_org)."""
    spec = spec.strip()
    if spec.startswith("git@") or spec.startswith("http"):
        url = spec
        slug = re.sub(r"\.git$", "", url.rstrip("/").split("/")[-1])
        return url, slug
    if "/" in spec:
        org, repo = spec.split("/", 1)
    else:
        if not default_org:
            die(f"no org for '{spec}'. Pass org/repo, or set "
                "defaults.github_org in sandbox.yml")
        org, repo = default_org, spec
    repo = re.sub(r"\.git$", "", repo)
    return f"https://github.com/{org}/{repo}.git", repo


def cmd_add(cfg, args) -> None:
    """Clone a plugin repo and wire it into the active project locally."""
    inst = args.resolved_instance
    defaults = cfg.get("defaults", {}) or {}
    plugins_home = _plugins_home(cfg)

    url, slug = parse_repo(args.repo, defaults.get("github_org"))
    dest = plugins_home / slug

    if dest.exists():
        info(f"{slug} already at {dest} — reusing")
    else:
        info(f"Cloning {url} → {dest}")
        run(["git", "clone", url, str(dest)])
        ok(f"Cloned {slug}")

    # Symlink + activate in the live runtime
    plug_dir = plugins_dir(inst)
    plug_dir.mkdir(parents=True, exist_ok=True)
    link = plug_dir / slug
    _force_symlink(link, dest)
    ok(f"Linked {slug} → {dest}")
    _drop_sandbox_claude_md(dest, slug, cfg)

    wpcli(["plugin", "activate", slug], instance=inst, check=False)

    # Persist into sandbox.local.yml so `./sb use <active>` re-applies it
    persist_local_plugin(args.project or _active_project_name(inst),
                         slug, str(dest))


def _active_project_name(instance: str = DEFAULT_INSTANCE) -> str | None:
    apf = active_project_file(instance)
    return apf.read_text().strip() if apf.exists() else None


def persist_local_plugin(project: str | None, slug: str, source: str) -> None:
    if not project:
        info("(no active project — added to runtime only; "
             "run `./sb use <name>` first to make it sticky)")
        return
    ensure_pyyaml()
    import yaml
    local = {}
    if CONFIG_LOCAL.exists():
        with CONFIG_LOCAL.open() as f:
            local = yaml.safe_load(f) or {}
    proj = local.setdefault("projects", {}).setdefault(project, {})
    plugins = proj.setdefault("plugins", [])
    if not any(p.get("slug") == slug for p in plugins):
        plugins.append({"slug": slug, "source": source})
        with CONFIG_LOCAL.open("w") as f:
            yaml.safe_dump(local, f, default_flow_style=False, sort_keys=False)
        ok(f"Persisted '{slug}' under projects.{project} in sandbox.local.yml")


def cmd_doctor(cfg, args) -> None:
    """Audit the whole stack and report what's broken."""
    inst = args.resolved_instance
    inst_cfg = resolve_instances(cfg)[inst]
    adm = inst_cfg["admin"]
    port = inst_cfg["wordpress_port"]
    problems = 0

    print(f"\nInstance: {inst}  (http://localhost:{port})")

    def check(label: str, ok_: bool, hint: str = "") -> None:
        nonlocal problems
        mark = "✓" if ok_ else "✗"
        line = f"  {mark} {label}"
        if not ok_:
            problems += 1
            if hint:
                line += f"\n      → {hint}"
        print(line)

    print("\nContainers:")
    ps = compose("ps", "--format", "json", instance=inst,
                 check=False, capture=True)
    containers = []
    for ln in (ps.stdout or "").splitlines():
        try:
            containers.append(json.loads(ln))
        except ValueError:
            pass
    services = {c.get("Service"): c.get("State") for c in containers}
    for svc in ("wp", "db", "mailpit"):
        check(f"{svc} running", services.get(svc) == "running",
              hint=f"./sb up --instance {inst}   (currently: {services.get(svc, 'missing')})")

    print("\nWordPress:")
    r = wpcli(["core", "is-installed"], instance=inst,
              check=False, capture=True)
    check("core installed", r.returncode == 0,
          hint=f"./sb install --instance {inst}")

    print("\nMCP wiring:")
    if inst == DEFAULT_INSTANCE:
        mcp_cfg = (cfg.get("mcp", {}) or {}).get("wp", {}) or {}
        app_pw = mcp_cfg.get("application_password", "")
    else:
        app_pw = ((cfg.get("instances", {}) or {}).get(inst, {}) or {}
                  ).get("app_password", "")
    check("application_password set", bool(app_pw),
          hint=f"./sb install --instance {inst}   (auto-provisions)")
    if app_pw:
        try:
            import base64, urllib.request, urllib.error
            req = urllib.request.Request(
                f"http://localhost:{port}/wp-json/wp/v2/users/me")
            token = base64.b64encode(
                f"{adm.get('user', 'admin')}:{app_pw}".encode()).decode()
            req.add_header("Authorization", f"Basic {token}")
            try:
                with urllib.request.urlopen(req, timeout=5) as r:
                    status = r.status
            except urllib.error.HTTPError as e:
                status = e.code
            check(f"REST auth works (status {status})", 200 <= status < 300,
                  hint=f"rerun ./sb install --instance {inst} to refresh the password")
        except Exception as e:
            check("REST auth works", False, hint=str(e))
    check("wp-mcp venv built", (MCP_VENV / "bin" / "python").exists(),
          hint="./sb mcp-install")

    print("\nState:")
    active = _active_project_name(inst)
    check(f"active project: {active or '—'}", bool(active),
          hint=f"./sb use <name> --instance {inst}")
    ff = focus_file(inst)
    focus = ff.read_text().strip() if ff.exists() else None
    check(f"focused plugin: {focus or '—'}", True,
          hint="(optional — set with ./sb focus <slug>)")

    print("\nLinked plugins:")
    plug_dir = plugins_dir(inst)
    expected = []
    if active:
        proj = (cfg.get("projects", {}) or {}).get(active, {}) or {}
        expected = [p.get("slug") for p in (proj.get("plugins") or [])]
    if not plug_dir.exists() and expected:
        check("wp-content/plugins/ exists", False,
              hint=f"./sb use <name> --instance {inst}")
    elif plug_dir.exists():
        linked = []
        for entry in sorted(plug_dir.iterdir()):
            if entry.is_symlink():
                linked.append(entry.name)
                tgt = entry.resolve()
                check(f"{entry.name} → {tgt}", tgt.exists(),
                      hint=f"source missing — ./sb add {entry.name}")
        for slug in expected:
            if slug not in linked:
                check(f"{slug} linked", False,
                      hint=f"./sb add {slug}   (project expects it)")
        if not linked and not expected:
            info("  (no source-symlinked plugins — project uses install_from_wporg only)")

    print()
    if problems:
        info(f"{problems} issue(s) — see → hints above")
        sys.exit(1)
    ok("All checks passed.")


