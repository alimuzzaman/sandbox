#!/bin/sh
# Sandbox CLI — entry point for everyone (designers, devs, QA).
# All configuration lives in sandbox.yml. Run `./sb` for help.
#
# Polyglot bootstrap: the shell catches a missing python3 with a friendly
# install hint, then re-execs this same file under python3. Python's parser
# treats the next triple-quoted block as the module docstring and skips it.
""":"
if ! command -v python3 >/dev/null 2>&1; then
    # Detect a package manager and offer to install python3 right here (this
    # runs before any Python, so the offer must be shell). Default is No;
    # non-interactive (no TTY) always falls through to the printed hint.
    sb_pm=""; sb_cmd=""
    if command -v brew >/dev/null 2>&1; then
        sb_pm="Homebrew"; sb_cmd="brew install python"
    elif command -v apt-get >/dev/null 2>&1; then
        sb_pm="apt"; sb_cmd="sudo apt-get install -y python3 python3-venv"
    elif command -v dnf >/dev/null 2>&1; then
        sb_pm="dnf"; sb_cmd="sudo dnf install -y python3 python3-virtualenv"
    fi
    echo "python3 is required to run ./sb but was not found." >&2
    if [ -n "$sb_cmd" ] && [ -t 0 ]; then
        printf "Install python3 via %s now? [y/N] " "$sb_pm" >&2
        read sb_ans
        case "$sb_ans" in
            y|Y|yes|YES)
                echo "  running: $sb_cmd" >&2
                if sh -c "$sb_cmd" >&2; then
                    command -v python3 >/dev/null 2>&1 && exec python3 "$0" "$@"
                    echo "install ran but python3 still not on PATH — open a new shell and re-run ./sb setup." >&2
                    exit 1
                fi
                echo "install failed — run it manually, then re-run ./sb setup." >&2
                exit 1 ;;
        esac
    fi
    cat <<'EOF' >&2

Install it, then re-run ./sb setup:
  • macOS:          brew install python
  • Ubuntu/Debian:  sudo apt install python3 python3-venv
  • Fedora/RHEL:    sudo dnf install python3 python3-virtualenv
  • Windows (WSL):  install Ubuntu via WSL, then the Ubuntu line above
  • Or use pyenv:   https://github.com/pyenv/pyenv
EOF
    exit 1
fi

# The package requires Python >= 3.12 (f-string backslashes and newer stdlib
# behavior are load-bearing). A bare `python3` can be an older interpreter —
# e.g. a pyenv shim pinned to 3.11 — so pick the newest supported one that is
# actually present instead of trusting PATH order. Preference: a versioned
# binary (python3.13/3.12), then plain python3, and only then the repo's
# .cli-venv — each versioned-less candidate must itself report >= 3.12.
SB_PY=""
for sb_candidate in python3.13 python3.12 python3 .cli-venv/bin/python; do
    if [ "${sb_candidate#./}" != "$sb_candidate" ]; then
        # Repo-relative venv interpreter must exist and be executable.
        [ -x "$sb_candidate" ] || continue
    else
        # A pyenv shim passes `command -v` even when the selected version does
        # not provide that binary, so discovery alone is not sufficient.
        command -v "$sb_candidate" >/dev/null 2>&1 || continue
    fi
    # Execute every candidate, including the repo-local venv, and keep the
    # Python >= 3.12 contract at the bootstrap boundary.
    sb_major=$("$sb_candidate" -c 'import sys;print(sys.version_info[0])' 2>/dev/null) || continue
    sb_minor=$("$sb_candidate" -c 'import sys;print(sys.version_info[1])' 2>/dev/null) || continue
    if [ "${sb_major:-0}" -lt 3 ] 2>/dev/null \
        || { [ "$sb_major" -eq 3 ] 2>/dev/null && [ "${sb_minor:-0}" -lt 12 ] 2>/dev/null; }; then
        continue
    fi
    SB_PY="$sb_candidate"
    break
done
if [ -z "$SB_PY" ]; then
    echo "sandbox needs Python >= 3.12; found only older interpreters on PATH." >&2
    echo "Install Python 3.12+ (see versions above) or run ./sb setup." >&2
    exit 1
fi
exec "$SB_PY" "$0" "$@"
":"""

